# Copy to .env (never commit .env). Same JWT_SECRET in EVERY service.
JWT_SECRET=change-me-to-a-long-random-string
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xenia
MYSQL_PASSWORD=xenia
MYSQL_DATABASE=xenia
KAFKA_BOOTSTRAP=localhost:9092
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- switches for the performance experiments (spec 9) ----
SEARCH_CACHE=on                  # on | off : the Redis cache for search and availability
SEARCH_CACHE_TTL_SECONDS=600
# Start the Kafka consumers inside this service (live availability push, rating updates). on | off
RUN_CONSUMERS=on
