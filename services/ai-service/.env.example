# Copy to .env (never commit .env). Same JWT_SECRET in EVERY service.
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Listing data: the READ-ONLY MySQL user (infra/mysql/02_users.sql). Agents can never write.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_reader
MYSQL_PASSWORD=ai_reader_dev
MYSQL_DATABASE=xenia            # xenia_eval for the 200-property evaluation pool (grant ai_reader SELECT there too)

# The debate record (tasks, events, results, feedback, versions)
MONGO_URL=mongodb://localhost:27017      # mongomock:// = in-memory stand-in (one process only)
MONGO_DATABASE=xenia

KAFKA_BOOTSTRAP=localhost:9092
# KAFKA_TRANSPORT=memory        # in-process Kafka: only works together with AI_RUN_WORKERS_IN_PROCESS=on

# Development only: run every agent inside the API process instead of six worker processes
AI_RUN_WORKERS_IN_PROCESS=off

# ---- language model (optional). Without a key the rule-based parser and template explanation are used. ----
ANTHROPIC_API_KEY=
AI_SMALL_MODEL=claude-haiku-5-5
AI_FRONTIER_MODEL=claude-sonnet-5-5
AI_MODEL_TIMEOUT_SECONDS=8

# ---- switches for the evaluation and performance runs ----
AI_MODE=full                    # full | matcher_only | no_auditor  (spec 7.3.1 configurations)
SEMANTIC_CACHE=on               # on | off  (JMeter "B" vs "B+S")
SEMANTIC_CACHE_THRESHOLD=0.95
AI_ROUND_DEADLINE_MS=8000       # rounds 0 and 2
AI_STEP_DEADLINE_MS=10000       # parser and explanation
AI_TASK_TIMEOUT_SECONDS=90      # whole debate, then status timed_out
