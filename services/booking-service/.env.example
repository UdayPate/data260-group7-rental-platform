# Copy to .env (never commit .env). Same JWT_SECRET in EVERY service.
JWT_SECRET=change-me-to-a-long-random-string
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xenia
MYSQL_PASSWORD=xenia
MYSQL_DATABASE=xenia
KAFKA_BOOTSTRAP=localhost:9092
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- switches for the performance experiments (spec 9) ----
# on  = API + Kafka + worker  ("B+S+K": the API answers 202 and the worker holds the dates)
# off = the API holds the dates itself in ONE transaction, same constraint ("B" baseline; no Kafka needed)
USE_KAFKA=on

# Worker only: how often the daily job (complete finished stays, expire stale requests) runs. It also runs once at start-up.
DAILY_JOB_INTERVAL_SECONDS=86400
