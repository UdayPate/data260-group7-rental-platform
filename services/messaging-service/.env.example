# Copy to .env (never commit .env). Same JWT_SECRET in EVERY service.
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONGO_URL=mongodb://localhost:27017      # mongomock:// = in-memory stand-in (data lost on restart)
MONGO_DATABASE=xenia
KAFKA_BOOTSTRAP=localhost:9092
# Load the mock's 5 threads and 12 messages if the collection is empty (or run: python -m messaging_service.seed)
SEED_ON_START=on
# The services this one asks for names, listings and reservations (with the caller's own token)
USER_API_BASE_URL=http://localhost:8001
PROPERTY_API_BASE_URL=http://localhost:8002
BOOKING_API_BASE_URL=http://localhost:8003
