# Copy this file to .env.local and fill in values. Never commit .env.local.

# Mock Service Worker (MSW) mocks are ON unless this is "false".
VITE_USE_MOCKS=true

# Base URL of each backend service, e.g. http://localhost:8001
# Leave empty to call the same server as the frontend (what the mocks intercept).
VITE_USER_API_BASE_URL=
VITE_PROPERTY_API_BASE_URL=
VITE_BOOKING_API_BASE_URL=
VITE_MESSAGING_API_BASE_URL=
VITE_REVIEW_API_BASE_URL=
VITE_ANALYTICS_API_BASE_URL=
VITE_AI_API_BASE_URL=

# WebSockets use the same base URLs (http -> ws, https -> wss): the AI stream uses the AI
# service's, the live availability stream (spec 13.4) the Property service's.
# The JWT secret is NOT a frontend setting: it lives only in each backend service's .env.
